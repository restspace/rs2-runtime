{
  "name": "rs2-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RS2 on Cloudflare Workers: the TypeScript host of the RS2 HTTP API (docs/agents/cloudflare.md)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "node scripts/deploy.mjs",
    "deploy:verify": "node scripts/deploy.mjs --verify",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:shim": "node scripts/build-shim.mjs",
    "vendor:hash-wasm": "node scripts/vendor-hash-wasm.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260825.1",
    "hash-wasm": "^4.12.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.126.0"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "jsonata": "^2.2.2"
  }
}
