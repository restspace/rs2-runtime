{
  "mounts": [
    {
      "path": "/files",
      "service": "file",
      "config": { "access": "open" }
    },
    {
      "config": {
        "enforceSchema": true,
        "access": "open"
      },
      "path": "/data",
      "service": "data"
    },
    {
      "path": "/services",
      "service": "services",
      "config": { "access": "open" }
    },
    {
      "path": "/q",
      "service": "query",
      "config": { "access": "open" }
    },
    {
      "path": "/pipes",
      "service": "pipeline",
      "config": { "access": "open" }
    }
  ]
}
