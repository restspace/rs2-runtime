{
  "description": "User store facade. GET reads (a key, or the listing); PUT takes { password, roles?, kind? }, hashes the password into passwordHash (argon2id), and writes the record to /data/users/<key>.",
  "access": { "read": "authenticated", "write": "A", "invoke": "A" },
  "pipeline": {
    "mode": "conditional",
    "steps": [
      {
        "if": "method == 'GET' && isDirectory",
        "call": { "method": "GET", "url": "/data/users/" }
      },
      {
        "if": "method == 'GET'",
        "call": { "method": "GET", "url": "/data/users/${url.path[0]}" }
      },
      {
        "if": "method == 'PUT'",
        "pipeline": {
          "mode": "serial",
          "steps": [
            {
              "transform": {
                "passwordHash": "$hashPassword(password)",
                "roles": "roles ? roles : 'U'",
                "kind": "kind ? kind : 'user'"
              }
            },
            {
              "call": { "method": "PUT", "url": "/data/users/${url.path[0]}", "effect": "idempotent" }
            }
          ]
        }
      }
    ]
  }
}
