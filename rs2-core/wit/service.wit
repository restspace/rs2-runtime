// RS2 engine-neutral service contract, v0.1 (PRD §5.4).
//
// M1 note: bodies cross this boundary materialized (`option<list<u8>>`)
// rather than as streaming resources. Component-model streams are still
// maturing (PRD open question 1); the streaming `body` resource lands when
// `wasi:io` streams stabilize in components. Host-side size limits apply at
// the boundary, so invariant 1 (bounded materialization) still holds.

package rs2:service@0.1.0;

interface types {
  record header { name: string, value: string }

  record body-data {
    media-type: string,
    schema-ref: option<string>,
    bytes: list<u8>,
  }

  record message {
    method: string,
    url: string,
    headers: list<header>,
    status: u16,
    body: option<body-data>,
  }

  enum log-level { debug, info, warn, error }

  variant host-error {
    capability-denied(string),
    limit-exceeded(string),
    failed(string),
  }
}

interface host {
  use types.{message, log-level, host-error};

  // Capability-scoped call; names resolve against config grants.
  request: func(capability: string, msg: message) -> result<message, host-error>;
  log: func(level: log-level, text: string);
  state-get: func(key: string) -> option<list<u8>>;
  state-put: func(key: string, value: list<u8>);
}

world service {
  import host;
  use types.{message};

  export init: func(config: string) -> result<_, string>;
  export handle: func(msg: message, config: string) -> result<message, string>;
}
